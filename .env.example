DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MAX_TOKENS=16384
# Defaults to deepseek and preserves the legacy settings above.
LLM_PROVIDER=deepseek
# To switch endpoints, set LLM_PROVIDER=openai_compatible and set these:
# LLM_API_URL=https://your-provider.example/v1/chat/completions
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-api-key
# LLM_MAX_TOKENS=16384
# LLM_JSON_MODE=true
# LLM_TEMPERATURE=0.1
# Use omit for LLM_TEMPERATURE if the model does not support it.
# LLM_TOKEN_PARAMETER=max_tokens
# Alternatively: max_completion_tokens
# LLM_EXTRA_BODY={}
# Claude native: LLM_PROVIDER=anthropic, LLM_MODEL=<model-id>, LLM_API_KEY=<key>
# Gemini native: LLM_PROVIDER=gemini, LLM_MODEL=<model-id>, LLM_API_KEY=<key>
# Native providers have default URLs; remove an old LLM_API_URL when switching.
# ANTHROPIC_API_KEY / GEMINI_API_KEY are fallbacks when LLM_API_KEY is unset.
# Gemini LLM_API_URL may contain {model}; uses generateContent, not Vertex AI auth.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=postgresql
DATABASE_URL=postgresql://resume_tailor:change_me@localhost:5432/resume_tailor
